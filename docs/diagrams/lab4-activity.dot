digraph Activity {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.4, nodesep=0.45, ranksep=0.45, fontname="Arial", fontsize=24, labelloc=t, label="ЛР4 · Диаграмма действий\nПосадка десантника на корабль"];
  node [shape=box, style="rounded,filled", fillcolor="#eaf3ff", color="#4978ab", fontname="Arial", fontsize=15, margin="0.2,0.13"];
  edge [fontname="Arial", fontsize=12, color="#4c6078", arrowsize=0.8];
  start [shape=circle, label="", width=0.2, style=filled, fillcolor="#25364b", color="#25364b"];
  request [label="Браузер: POST /starship/54/board/12\nHAProxy выбирает доступный узел"];
  controller [label="StarshipController.board(54, 12)\nИзвлечь параметры REST-запроса"];
  soap [label="MuleStarshipClient\nОтправить параметры в JSON по HTTPS"];
  soapmule [label="Mule :27781 → SOAP listener нужного узла\nDataWeave: JSON → SOAP XML", fillcolor="#fff0d5", color="#bc8b34"];
  endpoint [label="StarshipEndpoint.board(54, 12)\nВызвать StarshipBean через EJB-контейнер"];
  ids [shape=diamond, label="Оба ID > 0?", fillcolor="#fff0d5", color="#bc8b34"];
  find [label="StarshipRepository\nНайти корабль 54", fillcolor="#dff4e9", color="#4b9671"];
  found [shape=diamond, label="Корабль найден?", fillcolor="#fff0d5", color="#bc8b34"];
  occupied [shape=diamond, label="Десантник уже\nна каком-либо корабле?", fillcolor="#fff0d5", color="#bc8b34"];
  check [label="SpaceMarineClient.exists(12)\nGET http://127.0.0.1:27780/space-marines/12"];
  mule [label="Mule: space-marine-proxy\nGET https://127.0.0.1:27443/space-marines/12", fillcolor="#fff0d5", color="#bc8b34"];
  sm [label="SpaceMarineController → SpaceMarineBean\n→ SpaceMarineRepository → БД\nПолучить ответ о десантнике"];
  status [shape=diamond, label="Результат вызова\nчерез Mule?", fillcolor="#fff0d5", color="#bc8b34"];
  save [label="StarshipBean + StarshipRepository\nДобавить ID 12 в экипаж корабля 54\nСохранить связь в транзакции", fillcolor="#dff4e9", color="#4b9671"];
  result [label="StarshipDto → SOAP Ship → XML → Mule\nDataWeave: SOAP → JSON → REST-прослойка"];
  ok [label="HTTP 200\nБраузер показывает обновлённый экипаж", fillcolor="#dff4e9", color="#4b9671"];
  bad [label="Ошибка параметров · 400", fillcolor="#fde9e7", color="#bc675e"];
  noship [label="Корабль не найден · 404", fillcolor="#fde9e7", color="#bc675e"];
  conflict [label="Десантник уже занят · 409", fillcolor="#fde9e7", color="#bc675e"];
  nomarine [label="Десантник не найден · 404", fillcolor="#fde9e7", color="#bc675e"];
  unavailable [label="Зависимость недоступна · 503", fillcolor="#fde9e7", color="#bc675e"];
  internal [label="Неожиданный ответ 400\nот зависимости · ошибка 500", fillcolor="#fde9e7", color="#bc675e"];
  fault [label="StarshipEndpoint: StarshipFault\nКод ошибки передаётся в detail.status\nREST-обработчик: HTTP-статус + JSON", fillcolor="#fde9e7", color="#bc675e"];
  finish [shape=doublecircle, label="", width=0.2, style=filled, fillcolor="#25364b", color="#25364b"];
  { node [group="main"]; start; request; controller; soap; endpoint; ids; find; found; occupied; check; mule; sm; status; save; result; ok; finish; }
  start -> request -> controller -> soap -> soapmule -> endpoint -> ids [weight=30];
  ids -> find [label="Да", weight=30];
  ids -> bad [label="Нет"];
  find -> found [weight=30];
  found -> occupied [label="Да", weight=30];
  found -> noship [label="Нет"];
  occupied -> check [label="Нет", weight=30];
  occupied -> conflict [label="Да"];
  check -> mule -> sm -> status [weight=30];
  status -> save [label="200: существует", weight=30];
  status -> nomarine [label="404"];
  status -> unavailable [label="Сетевая ошибка / таймаут\nили иной статус, включая 502"];
  status -> internal [label="400"];
  save -> result -> ok -> finish [weight=30];
  bad -> fault;
  noship -> fault;
  conflict -> fault;
  nomarine -> fault;
  unavailable -> fault;
  internal -> fault;
  fault -> finish;
  note [shape=plain, fontsize=12, fontcolor="#596578", label="Ромбы — проверки; зелёные блоки — данные и успешное завершение; красные — ошибки.\nПри недоступности Mule прямого обхода к SpaceMarine нет.\nПоказаны основные ветви board; сбои REST → SOAP и ошибки записи БД опущены.\nПроверка через HTTP и локальная запись в БД не образуют распределённую транзакцию."];
  finish -> note [style=invis];
}
