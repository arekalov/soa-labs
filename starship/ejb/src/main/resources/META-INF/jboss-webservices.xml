<?xml version="1.0" encoding="UTF-8"?>
<webservices xmlns="http://www.jboss.com/xml/ns/javaee" version="1.2">
    <context-root>starship-soap</context-root>
    <port-component>
        <ejb-name>StarshipEndpoint</ejb-name>
        <port-component-name>StarshipPort</port-component-name>
        <port-component-uri>/StarshipService</port-component-uri>
        <!-- JBossWS selects the connector before rewriting WSDL addresses. -->
        <transport-guarantee>CONFIDENTIAL</transport-guarantee>
    </port-component>
</webservices>
