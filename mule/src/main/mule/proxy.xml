<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd">
  <http:listener-config name="loopback">
    <http:listener-connection host="127.0.0.1" port="27780"/>
  </http:listener-config>
  <http:request-config name="spacemarine">
    <http:request-connection protocol="HTTPS" host="127.0.0.1" port="27443"
                             maxConnections="2" connectionIdleTimeout="10000">
      <tls:context>
        <tls:trust-store path="${SOA_TRUSTSTORE_PATH}" password="${SOA_TRUSTSTORE_PASSWORD}" type="pkcs12"/>
      </tls:context>
    </http:request-connection>
  </http:request-config>
  <!-- JSON facade input and SOAP upstream both use TLS. -->
  <http:listener-config name="json-loopback">
    <http:listener-connection protocol="HTTPS" host="127.0.0.1" port="27781">
      <tls:context>
        <tls:key-store path="${SOA_KEYSTORE_PATH}" password="${SOA_KEYSTORE_PASSWORD}"
                       keyPassword="${SOA_KEYSTORE_PASSWORD}" type="pkcs12" alias="starship"/>
      </tls:context>
    </http:listener-connection>
  </http:listener-config>
  <http:request-config name="starship-1">
    <http:request-connection protocol="HTTPS" host="localhost" port="27544"
                             maxConnections="2" connectionIdleTimeout="10000">
      <tls:context>
        <tls:trust-store path="${SOA_TRUSTSTORE_PATH}" password="${SOA_TRUSTSTORE_PASSWORD}" type="pkcs12"/>
      </tls:context>
    </http:request-connection>
  </http:request-config>
  <http:request-config name="starship-2">
    <http:request-connection protocol="HTTPS" host="localhost" port="27644"
                             maxConnections="2" connectionIdleTimeout="10000">
      <tls:context>
        <tls:trust-store path="${SOA_TRUSTSTORE_PATH}" password="${SOA_TRUSTSTORE_PASSWORD}" type="pkcs12"/>
      </tls:context>
    </http:request-connection>
  </http:request-config>
  <flow name="health" maxConcurrency="1">
    <http:listener config-ref="loopback" path="/health" allowedMethods="GET"/>
    <set-payload value="ok" mimeType="text/plain"/>
    <logger level="INFO" message="MULE_PROXY method=GET path=/health status=200 upstream=local"/>
  </flow>
  <flow name="space-marine-proxy" maxConcurrency="2">
    <http:listener config-ref="loopback" path="/space-marines/{id}" allowedMethods="GET">
      <http:response statusCode="#[attributes.statusCode default 200]"/>
      <http:error-response statusCode="502">
        <http:body>upstream unavailable</http:body>
      </http:error-response>
    </http:listener>
    <set-variable variableName="requestPath" value="#[attributes.requestPath]"/>
    <http:request config-ref="spacemarine" method="GET" path="#[vars.requestPath]"
                  responseTimeout="5000" followRedirects="false" sendBodyMode="NEVER">
      <http:headers>#[{'Accept': 'application/json'}]</http:headers>
      <http:response-validator>
        <http:success-status-code-validator values="100..599"/>
      </http:response-validator>
    </http:request>
    <logger level="INFO" message="#[ 'MULE_PROXY method=GET path=' ++ vars.requestPath ++ ' status=' ++ (attributes.statusCode as String) ++ ' upstream=https://127.0.0.1:27443' ]"/>
    <error-handler>
      <on-error-propagate logException="false">
        <logger level="WARN" message="#[ 'MULE_PROXY method=GET path=' ++ vars.requestPath ++ ' status=502 upstream=https://127.0.0.1:27443 error=' ++ (error.errorType.identifier as String) ]"/>
      </on-error-propagate>
    </error-handler>
  </flow>
  <flow name="starship-1-json-to-soap" maxConcurrency="2">
    <http:listener config-ref="json-loopback" path="/starship-1/operations/{operation}" allowedMethods="POST">
      <http:response statusCode="#[vars.httpStatus default 200]">
        <http:headers>#[{'Content-Type': 'application/json; charset=UTF-8'}]</http:headers>
      </http:response>
      <http:error-response statusCode="503">
        <http:body>#[output application/json --- {code: 503, message: 'Сервис Starship недоступен, повторите запрос позже', details: null}]</http:body>
        <http:headers>#[{'Content-Type': 'application/json; charset=UTF-8'}]</http:headers>
      </http:error-response>
    </http:listener>
    <set-variable variableName="operation" value="#[attributes.uriParams.operation]"/>
    <choice>
      <when expression='#[["list","getById","create","createWithId","rename","delete","board","unload"] contains vars.operation]'>
        <set-variable variableName="args" value="#[payload]"/>
        <set-payload value="#[${file::transforms/request.dwl}]"/>
        <http:request config-ref="starship-1" method="POST" path="/starship-soap/StarshipService"
                      responseTimeout="25000" followRedirects="false">
          <http:headers>#[{'Content-Type': 'text/xml; charset=UTF-8', 'SOAPAction': '&quot;&quot;'}]</http:headers>
          <http:response-validator>
            <http:success-status-code-validator values="100..599"/>
          </http:response-validator>
        </http:request>
        <set-payload value="#[${file::transforms/response.dwl}]"/>
        <set-variable variableName="httpStatus" value="#[payload.status]"/>
        <set-payload value="#[output application/json --- payload.body]"/>
      </when>
      <otherwise>
        <set-variable variableName="httpStatus" value="#[404]"/>
        <set-payload value="#[output application/json --- {code: 404, message: 'Неизвестная операция', details: null}]"/>
      </otherwise>
    </choice>
    <logger level="INFO" message="#[ 'MULE_ADAPTER node=starship-1 operation=' ++ vars.operation ++ ' status=' ++ (vars.httpStatus as String) ]"/>
    <error-handler>
      <on-error-propagate logException="false">
        <logger level="WARN" message="#[ 'MULE_ADAPTER node=starship-1 status=503 error=' ++ (error.errorType.identifier as String) ]"/>
      </on-error-propagate>
    </error-handler>
  </flow>
  <flow name="starship-2-json-to-soap" maxConcurrency="2">
    <http:listener config-ref="json-loopback" path="/starship-2/operations/{operation}" allowedMethods="POST">
      <http:response statusCode="#[vars.httpStatus default 200]">
        <http:headers>#[{'Content-Type': 'application/json; charset=UTF-8'}]</http:headers>
      </http:response>
      <http:error-response statusCode="503">
        <http:body>#[output application/json --- {code: 503, message: 'Сервис Starship недоступен, повторите запрос позже', details: null}]</http:body>
        <http:headers>#[{'Content-Type': 'application/json; charset=UTF-8'}]</http:headers>
      </http:error-response>
    </http:listener>
    <set-variable variableName="operation" value="#[attributes.uriParams.operation]"/>
    <choice>
      <when expression='#[["list","getById","create","createWithId","rename","delete","board","unload"] contains vars.operation]'>
        <set-variable variableName="args" value="#[payload]"/>
        <set-payload value="#[${file::transforms/request.dwl}]"/>
        <http:request config-ref="starship-2" method="POST" path="/starship-soap/StarshipService"
                      responseTimeout="25000" followRedirects="false">
          <http:headers>#[{'Content-Type': 'text/xml; charset=UTF-8', 'SOAPAction': '&quot;&quot;'}]</http:headers>
          <http:response-validator>
            <http:success-status-code-validator values="100..599"/>
          </http:response-validator>
        </http:request>
        <set-payload value="#[${file::transforms/response.dwl}]"/>
        <set-variable variableName="httpStatus" value="#[payload.status]"/>
        <set-payload value="#[output application/json --- payload.body]"/>
      </when>
      <otherwise>
        <set-variable variableName="httpStatus" value="#[404]"/>
        <set-payload value="#[output application/json --- {code: 404, message: 'Неизвестная операция', details: null}]"/>
      </otherwise>
    </choice>
    <logger level="INFO" message="#[ 'MULE_ADAPTER node=starship-2 operation=' ++ vars.operation ++ ' status=' ++ (vars.httpStatus as String) ]"/>
    <error-handler>
      <on-error-propagate logException="false">
        <logger level="WARN" message="#[ 'MULE_ADAPTER node=starship-2 status=503 error=' ++ (error.errorType.identifier as String) ]"/>
      </on-error-propagate>
    </error-handler>
  </flow>
</mule>
