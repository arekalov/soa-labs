<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot приносит свои реализации, а подсистемы WildFly пытаются обработать
  развёртывание сами: jaxrs подхватывает @Path, weld сканирует бины, jpa ищет
  persistence.xml. Пересечение кончается падением при старте контекста.

  logging исключён отдельно: WildFly подставляет свою привязку slf4j, а Spring Boot
  несёт Logback, и контекст падает с "LoggerFactory is not a Logback LoggerContext".
-->
<jboss-deployment-structure>
    <deployment>
        <exclude-subsystems>
            <subsystem name="jaxrs"/>
            <subsystem name="logging"/>
            <subsystem name="jpa"/>
            <subsystem name="weld"/>
            <subsystem name="webservices"/>
        </exclude-subsystems>
    </deployment>
</jboss-deployment-structure>
